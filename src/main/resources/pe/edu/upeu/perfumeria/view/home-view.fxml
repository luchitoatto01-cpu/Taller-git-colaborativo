<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<StackPane style="-fx-background-color: #FAF6EE" xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml" stylesheets="@style.css"
           fx:controller="pe.edu.upeu.perfumeria.controller.HomeController">
    <children>
        <VBox alignment="CENTER" spacing="10.0">
            <children>
                <ImageView fitWidth="350.0" preserveRatio="true" smooth="true">
                    <image><Image url="@../img/bienvenida.png"/></image>
                </ImageView>
                <Label text="أهلاً وسهلاً" textFill="#A8842F">
                    <font><Font name="System Bold" size="26.0"/></font>
                </Label>
                <Label text="Bienvenido a Parfums House" textFill="#16161A">
                    <font><Font name="Georgia Bold" size="30.0"/></font>
                </Label>
                <Label text="Esencias árabes · Oud · Ámbar · Almizcle" textFill="#666666">
                    <font><Font size="15.0"/></font>
                </Label>
                <HBox alignment="CENTER" spacing="25.0">
                    <children>
                        <VBox alignment="CENTER" prefWidth="180.0" styleClass="card">
                            <children>
                                <Label fx:id="lblClientes" styleClass="card-number" text="0"/>
                                <Label styleClass="card-title" text="Clientes"/>
                            </children>
                        </VBox>
                        <VBox alignment="CENTER" prefWidth="180.0" styleClass="card">
                            <children>
                                <Label fx:id="lblProductos" styleClass="card-number" text="0"/>
                                <Label styleClass="card-title" text="Perfumes"/>
                            </children>
                        </VBox>
                        <VBox alignment="CENTER" prefWidth="180.0" styleClass="card">
                            <children>
                                <Label fx:id="lblVentas" styleClass="card-number" text="0"/>
                                <Label styleClass="card-title" text="Ventas"/>
                            </children>
                        </VBox>
                    </children>
                </HBox>
                <Label fx:id="lblRuta" text="Base de datos:" textFill="#999999" wrapText="true"/>
            </children>
            <padding><Insets left="30.0" right="30.0"/></padding>
        </VBox>
    </children>
</StackPane>
