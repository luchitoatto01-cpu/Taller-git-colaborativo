<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<HBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" stylesheets="@style.css"
      fx:controller="pe.edu.upeu.perfumeria.controller.LoginController"
      prefHeight="520.0" prefWidth="860.0">
    <children>
        <VBox alignment="CENTER" prefWidth="420.0" spacing="12.0" styleClass="left-pane">
            <children>
                <Label styleClass="brand-mark" text="✦"/>
                <Label styleClass="brand-title" text="PARFUMS HOUSE"/>
                <Label styleClass="brand-sub" text="Perfumería de autor"/>
            </children>
        </VBox>
        <VBox alignment="CENTER_LEFT" prefWidth="440.0" spacing="12.0" styleClass="right-pane" HBox.hgrow="ALWAYS">
            <padding>
                <Insets left="50.0" right="50.0"/>
            </padding>
            <children>
                <Label styleClass="login-title" text="Bienvenido"/>
                <Label styleClass="muted" text="Ingrese sus credenciales para continuar"/>
                <Label styleClass="field-label" text="Usuario">
                    <VBox.margin><Insets top="14.0"/></VBox.margin>
                </Label>
                <TextField fx:id="txtUser" promptText="Usuario"/>
                <Label styleClass="field-label" text="Contraseña"/>
                <PasswordField fx:id="txtPassword" onAction="#handleLogin" promptText="Contraseña"/>
                <Label fx:id="lblError" styleClass="error-label"/>
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#handleLogin"
                        styleClass="button-login" text="INGRESAR"/>
            </children>
        </VBox>
    </children>
</HBox>
