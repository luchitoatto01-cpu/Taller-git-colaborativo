<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<VBox spacing="14.0" style="-fx-background-color: #FAF6EE;" stylesheets="@style.css"
      xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="pe.edu.upeu.perfumeria.controller.UsuarioController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>
    <children>
        <Label text="Gestión de Usuarios" textFill="#16161A">
            <font><Font name="System Bold" size="20.0"/></font>
        </Label>
        <VBox spacing="10.0" styleClass="panel">
            <children>
                <GridPane hgap="12.0" vgap="8.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0"/>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0"/>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0"/>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0"/>
                    </columnConstraints>
                    <children>
                        <Label styleClass="field-label" text="Nombre" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <TextField fx:id="txtNombre" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <Label styleClass="field-label" text="Apellido" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <TextField fx:id="txtApellido" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <Label styleClass="field-label" text="DNI" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                        <TextField fx:id="txtDni" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                        <Label styleClass="field-label" text="Teléfono" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                        <TextField fx:id="txtTelefono" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                        <Label styleClass="field-label" text="Usuario" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                        <TextField fx:id="txtUsername" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                        <Label styleClass="field-label" text="Contraseña" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                        <PasswordField fx:id="txtPassword" promptText="Contraseña" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                        <Label styleClass="field-label" text="Rol" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                        <ComboBox fx:id="cbRol" maxWidth="Infinity" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
                    </children>
                </GridPane>
                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#handleLimpiar" styleClass="button-secondary" text="Nuevo / Limpiar"/>
                        <Button mnemonicParsing="false" onAction="#handleGuardar" styleClass="button-login" text="Guardar"/>
                    </children>
                </HBox>
            </children>
        </VBox>
        <TableView fx:id="tableUsuario" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colNumero" prefWidth="40.0" text="N°"/>
                <TableColumn fx:id="colNombre" prefWidth="200.0" text="Nombre"/>
                <TableColumn fx:id="colUsuario" prefWidth="120.0" text="Usuario"/>
                <TableColumn fx:id="colRol" prefWidth="100.0" text="Rol"/>
                <TableColumn fx:id="colDni" prefWidth="100.0" text="DNI"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
        <HBox alignment="CENTER_RIGHT">
            <children>
                <Button mnemonicParsing="false" onAction="#handleEliminar" styleClass="button-action-delete" text="Eliminar"/>
            </children>
        </HBox>
    </children>
</VBox>
