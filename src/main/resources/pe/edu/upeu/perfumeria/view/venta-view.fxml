<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<VBox spacing="12.0" style="-fx-background-color: #FAF6EE;" stylesheets="@style.css"
      xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="pe.edu.upeu.perfumeria.controller.VentaController">
    <padding>
        <Insets bottom="15.0" left="20.0" right="20.0" top="15.0"/>
    </padding>
    <children>
        <Label text="Gestión de Ventas" textFill="#16161A">
            <font><Font name="System Bold" size="20.0"/></font>
        </Label>

        <!-- Nueva venta -->
        <VBox spacing="8.0" styleClass="panel">
            <children>
                <Label text="Nueva venta" textFill="#16161A">
                    <font><Font name="System Bold" size="14.0"/></font>
                </Label>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label minWidth="55.0" text="Cliente"/>
                        <TextField fx:id="txtBuscarCliente" onAction="#handleBuscarCliente" prefWidth="230.0" promptText="DNI (8 dígitos) o ID del cliente"/>
                        <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#handleBuscarCliente" styleClass="button-action-edit" text="Buscar"/>
                        <Label fx:id="lblCliente" text="Ningún cliente seleccionado" textFill="#8A8478"/>
                    </children>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label minWidth="55.0" text="Perfume"/>
                        <TextField fx:id="txtBuscarProducto" prefWidth="330.0" promptText="Escriba el nombre o la marca del perfume…"/>
                        <Label fx:id="lblStock" minWidth="-Infinity" text="Stock: -" textFill="#666666"/>
                        <Label minWidth="-Infinity" text="Cant."/>
                        <TextField fx:id="txtCantidad" prefWidth="55.0" text="1"/>
                        <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#handleAgregar" styleClass="button-action-edit" text="Agregar"/>
                    </children>
                </HBox>
                <ListView fx:id="lvProductos" managed="false" maxHeight="150.0" minHeight="0.0" prefHeight="150.0" visible="false"/>
                <TableView fx:id="tableCarrito" minHeight="110.0" prefHeight="130.0">
                    <columns>
                        <TableColumn fx:id="colCarProducto" prefWidth="420.0" text="Perfume"/>
                        <TableColumn fx:id="colCarCantidad" prefWidth="50.0" text="Cant."/>
                        <TableColumn fx:id="colCarPrecio" prefWidth="80.0" text="P. Unit."/>
                        <TableColumn fx:id="colCarSubtotal" prefWidth="80.0" text="Subtotal"/>
                    </columns>
                </TableView>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#handleQuitar" styleClass="button-action-delete" text="Quitar línea"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Total:" textFill="#16161A">
                            <font><Font name="System Bold" size="16.0"/></font>
                        </Label>
                        <Label fx:id="lblTotal" text="S/ 0.00" textFill="#16161A">
                            <font><Font name="System Bold" size="18.0"/></font>
                        </Label>
                        <Button mnemonicParsing="false" onAction="#handleRegistrar" styleClass="button-login" text="REGISTRAR VENTA"/>
                    </children>
                </HBox>
            </children>
        </VBox>

        <!-- Historial -->
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Label text="Historial de ventas" textFill="#16161A">
                    <font><Font name="System Bold" size="14.0"/></font>
                </Label>
                <Region HBox.hgrow="ALWAYS"/>
                <Button mnemonicParsing="false" onAction="#handleVerDetalle" styleClass="button-action-edit" text="Ver detalle"/>
            </children>
        </HBox>
        <TableView fx:id="tableVentas" minHeight="100.0" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colVNumero" prefWidth="40.0" text="N°"/>
                <TableColumn fx:id="colVId" prefWidth="70.0" text="Venta"/>
                <TableColumn fx:id="colVFecha" prefWidth="100.0" text="Fecha"/>
                <TableColumn fx:id="colVCliente" prefWidth="220.0" text="Cliente"/>
                <TableColumn fx:id="colVTotal" prefWidth="100.0" text="Total"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </children>
</VBox>
